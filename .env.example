# ==============================================================================
# TeacherAI — Root Environment Variable Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teacherai_db"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teacherai_db"

# Database Pool Settings (AI Service)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION (Caching, Rate Limiting & LangGraph Checkpoints)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Better Auth)
# ------------------------------------------------------------------------------
# Random secret string (minimum 16 chars) used to sign session cookies & tokens
BETTER_AUTH_SECRET="teacherai_super_secret_auth_token_32chars"

# Base URL of the web application
BETTER_AUTH_URL="http://localhost:3000"

# Shared secret between Next.js Web App and Python FastAPI AI Service
AI_SERVICE_SECRET="change_this_internal_service_secret"
SERVICE_SECRET="change_this_internal_service_secret"

# ------------------------------------------------------------------------------
# 4. PUBLIC WEB APP URLS & METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TeacherAI"

# Internal URL where Next.js communicates with Python FastAPI engine
AI_SERVICE_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# 5. LLM PROVIDERS (OpenAI & Anthropic)
# ------------------------------------------------------------------------------
# Active LLM provider choice: "openai" or "anthropic"
LLM_PROVIDER="openai"

# OpenAI API Key (Required for live Socratic tutor chat, quiz generation & embeddings)
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o"

# Anthropic API Key (Optional fallback)
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 7. S3 / MINIO OBJECT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="teacherai-uploads"

# ------------------------------------------------------------------------------
# 8. ENVIRONMENT MODE & RATE LIMITING
# ------------------------------------------------------------------------------
ENVIRONMENT="development"
NODE_ENV="development"

# CORS Allowed Origins (JSON array or comma-separated string)
ALLOWED_ORIGINS='["http://localhost:3000"]'

# Chat Rate Limits
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_CHAT_MAX=30
