# ==============================================
# TeacherAI — Root Environment Variables
# Copy to .env and fill in your values
# ==============================================

# ---- Database ----
DATABASE_URL="postgresql://teacherai:teacherai_secret@localhost:5432/teacherai_db"
DIRECT_DATABASE_URL="postgresql://teacherai:teacherai_secret@localhost:5432/teacherai_db"

# ---- Redis ----
REDIS_URL="redis://:redis_secret@localhost:6379"

# ---- Storage (MinIO) ----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="teacherai-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin_secret"

# ---- Better Auth ----
BETTER_AUTH_SECRET="change_this_to_a_random_32_char_secret"
BETTER_AUTH_URL="http://localhost:3000"

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- AI Service ----
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_SECRET="change_this_internal_service_secret"

# ---- OpenAI ----
OPENAI_API_KEY="sk-..."

# ---- Anthropic (optional fallback) ----
ANTHROPIC_API_KEY=""

# ---- Next.js ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TeacherAI"
