// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (better-auth required tables) ──────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  studentProfile StudentProfile?
  lessonSessions LessonSession[]
  quizAttempts   QuizAttempt[]
  homeworks      Homework[]
  achievements   UserAchievement[]
  uploadedFiles  UploadedFile[]
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Student Learning Profile ─────────────────────────────────────────────────

model StudentProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  level         String    @default("unknown") // beginner, intermediate, advanced
  weakTopics    String[]  @default([])
  strongTopics  String[]  @default([])
  learningSpeed String    @default("average") // slow, average, fast
  totalSessions Int       @default(0)
  totalMinutes  Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastSessionAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Lesson Sessions ──────────────────────────────────────────────────────────

model LessonSession {
  id          String        @id @default(cuid())
  userId      String
  threadId    String        @unique // LangGraph thread_id
  topic       String
  status      SessionStatus @default(ACTIVE)
  phase       String        @default("identify_level")
  durationMin Int?
  lessonPlan  Json?
  summary     String?
  startedAt   DateTime      @default(now())
  endedAt     DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages LessonMessage[]

  @@index([userId])
  @@index([status])
}

model LessonMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // user, assistant, system
  content   String   @db.Text
  phase     String?
  metadata  Json?
  createdAt DateTime @default(now())

  session LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ─── Quizzes & Assessments ────────────────────────────────────────────────────

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  topic       String
  score       Float
  maxScore    Float     @default(100)
  passed      Boolean
  timeSpentSec Int
  questions   Json // Snapshot of questions, options & user answers
  feedback    String?   @db.Text
  completedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Homework & Practice Tasks ────────────────────────────────────────────────

model Homework {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String         @db.Text
  topic       String
  difficulty  String         @default("medium")
  status      HomeworkStatus @default(ASSIGNED)
  submission  String?        @db.Text
  feedback    String?        @db.Text
  score       Float?
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─── Gamification & Achievements ──────────────────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g., "first_lesson", "quiz_master"
  name        String
  description String
  icon        String
  points      Int      @default(10)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ─── Uploaded Knowledge Documents (RAG) ───────────────────────────────────────

model UploadedFile {
  id         String   @id @default(cuid())
  userId     String
  filename   String
  mimeType   String
  sizeBytes  Int
  storageUrl String
  chunkCount Int      @default(0)
  vectorized Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  ADMIN
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum HomeworkStatus {
  ASSIGNED
  SUBMITTED
  GRADED
  OVERDUE
}
