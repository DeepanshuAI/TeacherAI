// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (better-auth required tables) ──────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  verifications  Verification[]
  studentProfile StudentProfile?
  lessonSessions LessonSession[]
  quizAttempts   QuizAttempt[]
  homeworks      Homework[]
  achievements   UserAchievement[]
  uploadedFiles  UploadedFile[]
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User?   @relation(fields: [identifier], references: [email])

  @@index([identifier])
}

// ─── Student Learning Profile ─────────────────────────────────────────────────

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  level           String   @default("unknown") // beginner, intermediate, advanced
  weakTopics      String[] @default([])
  strongTopics    String[] @default([])
  learningSpeed   String   @default("average")  // slow, average, fast
  totalSessions   Int      @default(0)
  totalMinutes    Int      @default(0)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastSessionAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Lesson Sessions ──────────────────────────────────────────────────────────

model LessonSession {
  id          String        @id @default(cuid())
  userId      String
  threadId    String        @unique  // LangGraph thread_id
  topic       String
  status      SessionStatus @default(ACTIVE)
  phase       String        @default("identify_level")
  durationMin Int?
  lessonPlan  Json?
  summary     String?
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  updatedAt   DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([threadId])
  @@index([userId, status])
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  type      MessageType @default(TEXT)
  metadata  Json?
  createdAt DateTime    @default(now())

  session LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

// ─── Quiz System ──────────────────────────────────────────────────────────────

model Quiz {
  id           String       @id @default(cuid())
  sessionId    String?
  userId       String
  topic        String
  difficulty   String       // easy, medium, hard
  questionType String       // mcq, true_false, fill_blank, short_answer, code
  questions    Json         // array of question objects
  createdAt    DateTime     @default(now())

  attempts QuizAttempt[]

  @@index([userId])
  @@index([topic])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  answers     Json     // array of {questionId, studentAnswer, isCorrect, score, feedback}
  totalScore  Float    @default(0)
  maxScore    Float    @default(0)
  percentage  Float    @default(0)
  timeTakenSec Int?
  completedAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@index([userId, completedAt])
}

// ─── Homework ─────────────────────────────────────────────────────────────────

model Homework {
  id          String         @id @default(cuid())
  userId      String
  sessionId   String?
  topic       String
  title       String
  description String
  tasks       Json           // array of task objects
  dueDate     DateTime?
  status      HomeworkStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

// ─── Achievements ─────────────────────────────────────────────────────────────

model Achievement {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  icon        String
  category    String
  threshold   Int     @default(1)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  progress      Int         @default(0)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

// ─── File Uploads ─────────────────────────────────────────────────────────────

model UploadedFile {
  id            String   @id @default(cuid())
  userId        String
  fileId        String   @unique
  filename      String
  mimeType      String
  sizeBytes     Int
  s3Key         String
  textExtracted Boolean  @default(false)
  chunkCount    Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fileId])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  ADMIN
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageType {
  TEXT
  QUIZ
  CODE
  SUMMARY
  HOMEWORK
}

enum HomeworkStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}
